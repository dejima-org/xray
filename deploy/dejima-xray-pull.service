# Install to /etc/systemd/system/, with dejima-xray-pull.timer. See README.md.
[Unit]
Description=Deploy the newest build of dejima-xray
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=site-deploy
Group=site-deploy
Environment=SITE_FORGE_API=https://gitbox.branderson.io/api/v1
Environment=SITE_REPO=dejima/xray
Environment=SITE_ROOT=/srv/www/xray.dejima.page
# A read:repository token for an account that can read only the sites it deploys,
# readable by root only.
LoadCredential=token:/etc/site-deploy/token
ExecStart=/usr/local/bin/pull-dejima-xray.sh

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/www/xray.dejima.page
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
